{
    "name": "php-noobs/php-refactor",
    "type": "library",
    "license": "MIT",
    "description": "High-level PHP refactoring orchestrator for composed workflows across specialized services.",
    "autoload": {
        "psr-4": {
            "PhpNoobs\\PhpRefactor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpNoobs\\PhpRefactor\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/php-noobs/member-graph"
        },
        {
            "type": "vcs",
            "url": "https://github.com/php-noobs/php-source-registry"
        },
        {
            "type": "vcs",
            "url": "https://github.com/php-noobs/php-rename"
        },
        {
            "type": "vcs",
            "url": "https://github.com/php-noobs/php-retype"
        }
    ],
    "require": {
        "php": ">=8.4",
        "php-noobs/member-graph": "dev-main",
        "php-noobs/php-rename": "dev-main",
        "php-noobs/php-retype": "dev-main",
        "php-noobs/php-source-registry": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "qa": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
